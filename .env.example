# 서울 열린데이터광장 (실시간 도시데이터)
SEOUL_API_KEY=

# 공공데이터포털 (상가정보)
DATA_GO_KR_KEY=

# 서울시 문화행사
SEOUL_CULTURE_KEY=

# 네이버 검색 API

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=


# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Gemini — 키가 둘이다. **지금은 부르는 곳이 모두 유료 키를 쓴다** (10/6).
# 무료 키는 하루·분당 한도가 있어 기획안을 몇 건 만들면 더 못 만들고, 메뉴 수집은
# 한 가게에 10분이 넘는다. 협력사 매입가가 들어가는 것도 있어 보낸 내용이 학습에
# 쓰이지 않는 쪽으로 보내는 것이 맞다.
# 유료 키가 비어 있으면 무료 키로 돈다.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GEMINI_MODEL=gemini-3.5-flash-lite

# 대표님 전용 화면 비밀번호 (필수)
# 없으면 로그인 화면에서 멈춘다. 배포 시에는 Streamlit Cloud secrets 에 넣는다.
OWNER_PASSWORD=1111

# 바틀링 좌표 (뚝섬로34길 67)
BOTTLING_LAT=37.5318919
BOTTLING_LNG=127.0679483

# 협업 제안서 「연락」 줄에 들어가는 연락처. 비우면 자리표시가 남는다.
BOTTLING_CONTACT=https://www.instagram.com/bottling.kr

# 「협의 사항 입력폼」 주소와 「확인 코드는 무엇인가요?」 문항의 번호.
# ENTRY 는 값이 아니라 문항을 가리키는 이름표다 — 협력사가 바뀌어도 그대로다.
# 둘이 있어야 보관함에서 협력사별 폼 링크를 만든다. 비우면 그 버튼이 막힌다.
#
# 뽑는 법 — 폼 편집 화면 오른쪽 위 점 세 개 → 「미리 작성된 링크 가져오기」
#   → 확인 코드 칸에 아무 값이나 넣고 링크를 받는다
#   → ?usp=pp_url& 앞이 URL, entry.숫자 가 CODE_ENTRY
PARTNER_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
PARTNER_FORM_CODE_ENTRY=entry.123456789
